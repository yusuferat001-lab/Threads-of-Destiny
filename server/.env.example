# Prisma bağlantı dizesi — artık PostgreSQL (eski SQLite "file:./dev.db" DEĞİL).
#
# Yerel geliştirme: bir Postgres çalıştır ve buraya onun adresini yaz. Örnekler:
#   Docker:  docker run --name kc-pg -e POSTGRES_PASSWORD=kader -e POSTGRES_DB=kadercarki -p 5432:5432 -d postgres:16
#            DATABASE_URL="postgresql://postgres:kader@localhost:5432/kadercarki"
#   Neon dev branch:  DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Prod (Render): bu değer Render panelinden (Environment → DATABASE_URL) girilir, repoya yazılmaz.
DATABASE_URL="postgresql://postgres:kader@localhost:5432/kadercarki"
PORT=3001

# İstatistik özetini okumak için (§32): GET /api/istatistik?key=<bu değer>
# ve GET /api/istatistik/panel?key=<bu değer>. Boşsa uç her zaman 403 döner
# (güvenli varsayılan). "ziyaret" olayı yazan POST /api/istatistik/olay anahtarsızdır.
ISTATISTIK_ANAHTARI=""

# Görüş & Öneri (§29) — geri bildirimler artık Neon Postgres'e yazılır (kalıcı).
# Kayıtları okumak için: GET /api/geri-bildirim?key=<bu değer>. Boşsa uç 403 döner.
GERI_BILDIRIM_ANAHTARI=""
# Opsiyonel anlık haber: yeni geri bildirim geldiğinde buraya da POST atılır.
#   Discord webhook URL'si  → {content}
#   https://api.telegram.org/bot<TOKEN>/sendMessage → {chat_id,text} (+ CHAT_ID gerekir)
GERI_BILDIRIM_WEBHOOK_URL=""
GERI_BILDIRIM_TELEGRAM_CHAT_ID=""
