generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  data      String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif])
}

model Score {
  id          Int      @id @default(autoincrement())
  isim        String
  skor        Float
  meslek      String
  rutbe       String   @default("")
  cag         String
  bolge       String
  yerlesim    String   @default("")
  kisilik     String   @default("")
  olum_nedeni String
  yas         Int
  para        Float
  un          Int
  /** Kazanılan ünvanlar, virgülle ayrılmış (ör. "İpek Kralı, Cesur Yürek"); liderlik tablosunda rozet olarak gösterilir. */
  unvanlar    String   @default("")
  /** Nadir/komik bir ölümse başlığı (ör. "Kendi Kazdığı Kuyuya Düşen"); boşsa sıradan bir ölüm. */
  efsanevi_olum String @default("")
  /** Hayat amacı tamamlanmış mı (skor zaten x5 uygulanmış olarak kaydedilir, bu sadece rozet için). */
  hayat_amaci_tamamlandi Boolean @default(false)
  createdAt   DateTime @default(now())
}

/// Toplu oyun metriği — append-only olay günlüğü (§32). Kalıcı (Neon), Render free
/// diskine bağımsız. Yalnız `GET /api/istatistik?key=…` (anahtar korumalı) okur;
/// oyuncuya hiç gösterilmez. Tek satır = tek olay (ziyaret / yeni_oyun / meslek_secim
/// / olum / skor_kaydi). Kişisel veri yok — `istemci_id` tarayıcıda üretilen rastgele
/// bir UUID'dir (tekil ziyaretçi tahmini için), IP/isim tutulmaz.
model Metrik {
  id          Int      @id @default(autoincrement())
  tur         String
  istemci_id  String   @default("")
  oturum_id   String   @default("")
  cag         String   @default("")
  bolge       String   @default("")
  yerlesim    String   @default("")
  meslek      String   @default("")
  yas         Int      @default(0)
  /// Oyun-içi oynanan tur (~yıl) sayısı — yalnız "olum"da anlamlı.
  tur_sayisi  Int      @default(0)
  /// Nakit + gayrimenkul değeri — yalnız "olum"da.
  servet      Float    @default(0)
  skor        Float    @default(0)
  olum_nedeni String   @default("")
  /// Gerçek-zaman oturum süresi (saniye): ölüm anı − Session.createdAt. Yalnız "olum"da.
  oturum_sn   Int      @default(0)
  meta        String   @default("")
  createdAt   DateTime @default(now())

  @@index([tur])
  @@index([createdAt])
}

/// Cihaz (istemci_id) bazlı çapraz-hayat olay geçmişi. Bir hayat ölünce o hayatın
/// `gecmis_olaylar`'ı buraya birleştirilir (en fazla ISTEMCI_GECMIS_MAKS tekil id,
/// en yeniler tutulur); bir sonraki hayat yaratılırken buradan okunup
/// `CharacterState.istemci_gecmis_olaylar`'a yazılır — `olaySec` bu listeyi normal
/// tekrar-önleme penceresine (§12) katarak aynı cihazdan art arda oynanan farklı
/// hayatlarda hep aynı olayların çıkmasını azaltır. Kişisel veri yok (rastgele UUID).
model IstemciOlayGecmisi {
  istemciId String   @id
  /// Olay id'lerinin JSON dizisi (kronolojik, en yeni sonda), capli.
  olaylar   String
  updatedAt DateTime @updatedAt
}

/// Ayarlar → "Görüş & Öneri" formundan gelen kullanıcı geri bildirimleri (§29).
/// Kalıcı (Neon) — eski JSONL yedeği kaldırıldı: Render "free" planında kalıcı disk
/// olmadığından her deploy/restart'ta siliniyordu. Yalnız `GET /api/geri-bildirim?key=…`
/// (anahtar korumalı) okur; oyuncuya hiç gösterilmez. Anlık haber için webhook
/// (`GERI_BILDIRIM_WEBHOOK_URL`) hâlâ opsiyonel olarak ayrıca gönderilir.
model GeriBildirim {
  id        String   @id
  kategori  String   @default("diger")
  mesaj     String
  iletisim  String?
  /// Oyun bağlamı (çağ/bölge/meslek/yaş/sürüm/userAgent…) — JSON.stringify'lı nesne.
  baglam    String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
